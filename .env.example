# Name of the app
APP_NAME="SmartRoomNepal"

# Port where the app will run
APP_PORT=8080

# Port where the Socket.IO server will run (separate from main API)
SOCKET_PORT=3001

# URL of the app where it will run
APP_URL=http://localhost:8080

CLIENT_URL=http://localhost:3000

# App Environment (development, production, testing)
NODE_ENV=production

# Origin allowed to make requests to the API separated by commas
ALLOWED_ORIGINS="http://localhost:3000"

# Session Configuration
EXPRESS_SESSION_SECRET="YOUR_SECRET"
COOKIE_SECRET="YOUR_SECRET"

# Database Configuration
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="smart_room_nepal"
DB_DIALECT="mysql"
DB_USER="root"
DB_PASSWORD=""

# Mail Configuration (SMTP)
MAIL_DRIVER="smtp"
EMAIL_HOST="EMAIL_HOST"
EMAIL_PORT=587
EMAIL_USERNAME="EMAIL_USERNAME"
EMAIL_PASSWORD="EMAIL_PASSWORD"
EMAIL_FROM_NAME="SmartRoomNepal"
EMAIL_FROM_ADDRESS="info@smartroomnepal.com"

#JWT Configuration (Secret key, expiration time, refresh secret key, refresh expiration time - Time in minutes)
JWT_EXPIRES_IN=15
JWT_REFRESH_EXPIRES_IN=20160
JWT_ISSUER="GYAN DANAM"
JWT_PRIVATE_KEY="YOUR PRIVATE KEY"
JWT_PUBLIC_KEY="YOUR PUBLIC"